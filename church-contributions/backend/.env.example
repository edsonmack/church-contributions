# Copy this file to .env and fill in your own values. Never commit .env.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/contributions?schema=public"
PORT=4000

# Secret used to sign login tokens. Must be at least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

# Set to false once your organisations exist, to close public sign-up during the pilot.
ALLOW_SIGNUP=true

# Optional: restrict which website may call the API (set this when deployed).
# CORS_ORIGIN="https://your-domain.com"
